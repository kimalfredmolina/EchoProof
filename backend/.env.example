PORT=5000

MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/echoproof

GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# Comma-separated owner/repo entries. Use * only for a trusted local deployment.
PRIVATE_REPOSITORY_ALLOWLIST=owner/private-repository

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=20000
ALLOW_EXTERNAL_SYNTHESIS=false

AGENT_TIMEOUT_MS=15000
GITHUB_TIMEOUT_MS=10000
QUERY_RATE_LIMIT_MAX=10

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# Exact allowed frontend origins, comma-separated. Do not include paths.
FRONTEND_URL=http://localhost:5173
